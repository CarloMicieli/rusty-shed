# Claude Code Ignore File
# Files and directories listed here will be excluded from Claude's context
# Syntax: Same as .gitignore (glob patterns)

# --- 1. Sensitive Data (Critical - Never Include) ---
.env
.env.*
*.pem
*.key
**/secrets/*
*.credentials.*
.credentials.json

# --- 2. Rust/Tauri Build Artifacts ---
# Target folder is huge and contains no useful context
src-tauri/target/
# Ignore compiled binaries and installers
src-tauri/gen/
src-tauri/bin/
# Cargo lock file (can be large, usually not needed for context)
src-tauri/Cargo.lock

# --- 3. Frontend/Svelte Build Output ---
dist/
build/
.svelte-kit/
# SvelteKit generated types (auto-generated, no need in context)
.svelte-kit/types/

# --- 4. Package Manager Files ---
# Lock files are huge and rarely needed for context
pnpm-lock.yaml
package-lock.json
yarn.lock
# Dependencies folder
node_modules/

# --- 5. Generated Files ---
# TypeScript bindings (auto-generated by tauri-specta)
# Uncomment if you don't want Claude to see generated bindings
# src/lib/bindings.ts

# Paraglide generated files (if you want to exclude translations)
# src/lib/paraglide/

# --- 6. Logs and Temporary Files ---
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- 7. IDE and Editor Configurations ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.fleet/
.vim/

# --- 8. Test Coverage and Reports ---
coverage/
.nyc_output/
*.lcov

# --- 9. Documentation/Specs (Optional) ---
# Uncomment if you want to exclude specification documents
# specs/
# docs/

# --- 10. Database Files ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# Keep test databases if needed for context
# !**/*.test.db

# --- 11. Large Media Files ---
*.mp4
*.mov
*.avi
*.mkv
*.zip
*.tar
*.tar.gz
*.rar

# --- 12. Cache Directories ---
.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/

# --- 13. OS and System Files ---
.Trash/
.Spotlight-V100/
.Trashes/
ehthumbs.db
Desktop.ini

# --- 14. Git Internals ---
.git/
.gitattributes
