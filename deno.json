{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns"]
  },
  "tasks": {
    "dev": "deno run -A npm:vite dev",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "prepare": "deno run -A npm:@inlang/paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "check": "deno run -A npm:@sveltejs/kit sync && deno run -A npm:svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "deno run -A npm:@sveltejs/kit sync && deno run -A npm:svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "deno run -A npm:prettier --write .",
    "format:check": "deno run -A npm:prettier --check .",
    "lint": "deno run -A npm:@sveltejs/kit sync && deno run -A npm:eslint .",
    "test:unit": "deno run -A npm:vitest --environment happy-dom",
    "test": "deno run -A npm:vitest --run --environment happy-dom",
    "tauri": "deno run -A npm:@tauri-apps/cli",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:build": "cargo build --manifest-path src-tauri/Cargo.toml",
    "rust:run": "cargo run --manifest-path src-tauri/Cargo.toml",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:clean": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "specta:generate": "cargo run --bin gen_types --manifest-path src-tauri/Cargo.toml"
  },
  "imports": {
    "effect": "npm:effect@^3.21.2",
    "@sinclair/typebox": "npm:@sinclair/typebox@0.34.49",
    "@floating-ui/dom": "npm:@floating-ui/dom@^1.7.6",
    "@tauri-apps/api": "npm:@tauri-apps/api@^2.11.0",
    "@tauri-apps/plugin-dialog": "npm:@tauri-apps/plugin-dialog@^2.7.1",
    "@tauri-apps/plugin-fs": "npm:@tauri-apps/plugin-fs@^2.5.1",
    "@tauri-apps/plugin-http": "npm:@tauri-apps/plugin-http@^2.5.9",
    "@tauri-apps/plugin-log": "npm:@tauri-apps/plugin-log@^2.8.0",
    "@tauri-apps/plugin-opener": "npm:@tauri-apps/plugin-opener@^2.5.4",
    "@tauri-apps/plugin-stronghold": "npm:@tauri-apps/plugin-stronghold@^2.3.1",
    "@tiptap/core": "npm:@tiptap/core@^3.22.5",
    "@tiptap/markdown": "npm:@tiptap/markdown@^3.22.5",
    "@tiptap/pm": "npm:@tiptap/pm@^3.22.5",
    "@tiptap/starter-kit": "npm:@tiptap/starter-kit@^3.22.5",
    "cropperjs": "npm:cropperjs@^2.1.1",
    "d3-array": "npm:d3-array@^3.2.4",
    "d3-scale": "npm:d3-scale@^4.0.2",
    "date-fns": "npm:date-fns@^4.1.0",
    "layerchart": "npm:layerchart@2.0.0-next.44",
    "marked": "npm:marked@^17.0.6",
    "shadcn-svelte": "npm:shadcn-svelte@1.1.1",
    "svelte-dnd-action": "npm:svelte-dnd-action@^0.9.69",
    "tailwind-merge": "npm:tailwind-merge@^3.5.0",
    "uuid": "npm:uuid@^13.0.1",
    "@eslint/compat": "npm:@eslint/compat@^2.0.5",
    "@eslint/js": "npm:@eslint/js@^9.39.4",
    "@inlang/paraglide-js": "npm:@inlang/paraglide-js@2.7.1",
    "@internationalized/date": "npm:@internationalized/date@^3.12.1",
    "@lucide/svelte": "npm:@lucide/svelte@^0.561.0",
    "@sveltejs/adapter-auto": "npm:@sveltejs/adapter-auto@^7.0.1",
    "@sveltejs/adapter-static": "npm:@sveltejs/adapter-static@^3.0.10",
    "@sveltejs/kit": "npm:@sveltejs/kit@^2.59.0",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.0.0",
    "@tailwindcss/forms": "npm:@tailwindcss/forms@0.5.11",
    "@tailwindcss/typography": "npm:@tailwindcss/typography@0.5.19",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.2.4",
    "@tauri-apps/cli": "npm:@tauri-apps/cli@^2.11.0",
    "@testing-library/jest-dom": "npm:@testing-library/jest-dom@^6.9.1",
    "@testing-library/svelte": "npm:@testing-library/svelte@^5.3.1",
    "@testing-library/user-event": "npm:@testing-library/user-event@^14.6.1",
    "@types/node": "npm:@types/node@^25.6.0",
    "@types/uuid": "npm:@types/uuid@^11.0.0",
    "@vitest/browser-playwright": "npm:@vitest/browser-playwright@^4.1.5",
    "@vitest/coverage-v8": "npm:@vitest/coverage-v8@^4.1.5",
    "bits-ui": "npm:bits-ui@^2.18.0",
    "clsx": "npm:clsx@^2.1.1",
    "eslint": "npm:eslint@^9.39.4",
    "eslint-config-prettier": "npm:eslint-config-prettier@^10.1.8",
    "eslint-plugin-svelte": "npm:eslint-plugin-svelte@^3.17.1",
    "formsnap": "npm:formsnap@^2.0.1",
    "globals": "npm:globals@^16.5.0",
    "happy-dom": "npm:happy-dom@^20.9.0",
    "lucide-svelte": "npm:lucide-svelte@^0.562.0",
    "mode-watcher": "npm:mode-watcher@^1.1.0",
    "playwright": "npm:playwright@^1.59.1",
    "prettier": "npm:prettier@^3.8.3",
    "prettier-plugin-svelte": "npm:prettier-plugin-svelte@^3.5.1",
    "prettier-plugin-tailwindcss": "npm:prettier-plugin-tailwindcss@^0.7.4",
    "svelte": "npm:svelte@^5.55.5",
    "svelte-check": "npm:svelte-check@^4.4.7",
    "svelte-sonner": "npm:svelte-sonner@^1.1.1",
    "sveltekit-superforms": "npm:sveltekit-superforms@^2.30.1",
    "tailwind-variants": "npm:tailwind-variants@^3.2.2",
    "tailwindcss": "npm:tailwindcss@^4.2.4",
    "tw-animate-css": "npm:tw-animate-css@^1.4.0",
    "typescript": "npm:typescript@^5.9.3",
    "typescript-eslint": "npm:typescript-eslint@^8.59.1",
    "vite": "npm:vite@^8.0.10",
    "vitest": "npm:vitest@^4.1.5",
    "vitest-browser-svelte": "npm:vitest-browser-svelte@^2.1.1",
    "zod": "npm:zod@^4.4.2"
  }
}
