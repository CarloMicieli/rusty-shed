{
  "name": "rusty-shed",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest --environment happy-dom",
    "test": "vitest --run --environment happy-dom",
    "test:ci": "vitest --run --environment happy-dom",
    "test:coverage": "vitest --run --environment happy-dom --coverage",
    "tauri": "tauri",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:build": "cargo build --manifest-path src-tauri/Cargo.toml",
    "rust:run": "cargo run --manifest-path src-tauri/Cargo.toml",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:clean": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings"
  },
  "license": "MIT",
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@skeletonlabs/skeleton-common": "^4.8.0",
