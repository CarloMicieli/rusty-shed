    "rust:run": "cargo run --manifest-path src-tauri/Cargo.toml",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:clean": "cargo clean --manifest-path src-tauri/Cargo.toml",
