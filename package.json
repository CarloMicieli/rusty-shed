{
  "name": "rusty-shed",
  "version": "0.2.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "svelte-kit sync && eslint .",
    "test:unit": "vitest --environment happy-dom",
    "test": "vitest --run --environment happy-dom",
    "test:ci": "vitest --run --environment happy-dom",
    "test:coverage": "vitest --run --environment happy-dom --coverage",
    "tauri": "tauri",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:build": "cargo build --manifest-path src-tauri/Cargo.toml",
    "rust:run": "cargo run --manifest-path src-tauri/Cargo.toml",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:clean": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "rust:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --lcov --output-path coverage/lcov.info",
    "rust:crap": "cargo crap --path src-tauri/ --lcov coverage/lcov.info",
    "specta:generate": "cargo run --bin gen_types --manifest-path src-tauri/Cargo.toml"
  },
  "license": "MIT",
