{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusty-shed.app/schemas/manifest/v1.json",
  "title": "Rusty Shed Import Manifest",
  "description": "Schema for the manifest.json file within Rusty Shed import packages",
  "type": "object",
  "required": ["version", "data"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema"
    },
    "version": {
      "type": "string",
      "enum": ["1.0"],
      "description": "Schema version"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the export was created"
    },
    "source": {
      "type": "string",
      "description": "Name and version of the application that created this export"
    },
    "data": {
      "$ref": "#/$defs/DataContainer"
    }
  },
  "$defs": {
    "DataContainer": {
      "type": "object",
      "properties": {
        "manufacturers": {
          "type": "array",
          "items": { "$ref": "#/$defs/Manufacturer" },
          "default": []
        },
        "railwayCompanies": {
          "type": "array",
          "items": { "$ref": "#/$defs/RailwayCompany" },
          "default": []
        },
        "railwayModels": {
          "type": "array",
          "items": { "$ref": "#/$defs/RailwayModel" },
          "default": []
        },
        "collectionItems": {
          "type": "array",
          "items": { "$ref": "#/$defs/CollectionItem" },
          "default": []
        },
        "sellers": {
          "type": "array",
          "items": { "$ref": "#/$defs/Seller" },
          "default": []
        },
        "maintenanceCards": {
          "type": "array",
          "items": { "$ref": "#/$defs/MaintenanceCard" },
          "default": []
        },
        "trackProducts": {
          "type": "array",
          "items": { "$ref": "#/$defs/TrackProduct" },
          "default": []
        },
        "trackInventories": {
          "type": "array",
          "items": { "$ref": "#/$defs/TrackInventory" },
          "default": []
        },
        "prototypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/Prototype" },
          "default": []
        },
        "formationCategories": {
          "type": "array",
          "items": { "$ref": "#/$defs/FormationCategory" },
          "default": []
        },
        "trainFormations": {
          "type": "array",
          "items": { "$ref": "#/$defs/TrainFormation" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "Manufacturer": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier within this manifest"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Manufacturer name, e.g., 'Märklin'"
        },
        "registeredCompanyName": {
          "type": "string",
          "description": "Legal company name"
        },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 country code"
        },
        "status": {
          "type": "string",
          "enum": ["active", "merged", "outOfBusiness"],
          "default": "active"
        },
        "websiteUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "RailwayCompany": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Railway company name, e.g., 'Deutsche Bahn'"
        },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"],
          "default": "active"
        }
      },
      "additionalProperties": false
    },
    "RailwayModel": {
      "type": "object",
      "required": [
        "id",
        "manufacturerId",
        "productCode",
        "description",
        "scale",
        "epoch",
        "category",
        "powerMethod"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "manufacturerId": {
          "type": "string",
          "minLength": 1,
          "description": "References manufacturers[].id"
        },
        "productCode": {
          "type": "string",
          "minLength": 1,
          "description": "Manufacturer's product code, e.g., '39010'"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable description"
        },
        "details": {
          "type": "string"
        },
        "scale": {
          "type": "string",
          "description": "Model scale, normalized during import. Accepts: H0, HO, N, TT, Z, G, 0, 00, 1"
        },
        "epoch": {
          "type": "string",
          "description": "Historical epoch, e.g., 'III', 'IV', 'V', 'VI'"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "powerMethod": {
          "type": "string",
          "enum": ["dc", "ac", "trixExpress"]
        },
        "deliveryDate": {
          "type": "string",
          "description": "Release date in ISO format or 'Q1 2024' style"
        },
        "availabilityStatus": {
          "type": "string",
          "enum": ["available", "announced", "cancelled", "discontinued"]
        },
        "image": {
          "type": "string",
          "description": "Filename in /images/ folder"
        },
        "rollingStocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/RollingStock" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "Category": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "locomotive",
            "passengerCar",
            "freightCar",
            "electricMultipleUnit",
            "railcar",
            "trainSet"
          ]
        },
        "subType": {
          "type": "string",
          "description": "Category-specific subtype, e.g., 'steam', 'electric', 'tank', 'covered'"
        }
      },
      "additionalProperties": false
    },
    "RollingStock": {
      "type": "object",
      "required": ["railwayCompanyId", "seriesCode"],
      "properties": {
        "railwayCompanyId": {
          "type": "string",
          "minLength": 1,
          "description": "References railwayCompanies[].id"
        },
        "seriesCode": {
          "type": "string",
          "minLength": 1,
          "description": "Series identifier, e.g., 'BR 01'"
        },
        "roadNumber": {
          "type": "string",
          "description": "Vehicle number, e.g., '01 118'"
        },
        "livery": {
          "type": "string"
        },
        "friendlyName": {
          "type": "string"
        },
        "isDummy": {
          "type": "boolean",
          "default": false,
          "description": "True for non-powered units in sets"
        },
        "lengthOverBuffers": {
          "type": "number",
          "minimum": 0,
          "description": "Length in mm"
        }
      },
      "additionalProperties": false
    },
    "CollectionItem": {
      "type": "object",
      "required": ["id", "railwayModelId", "addedDate"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "railwayModelId": {
          "type": "string",
          "minLength": 1,
          "description": "References railwayModels[].id"
        },
        "addedDate": {
          "type": "string",
          "format": "date",
          "description": "Date added to collection (YYYY-MM-DD)"
        },
        "removedDate": {
          "type": "string",
          "format": "date"
        },
        "purchaseCondition": {
          "type": "string",
          "enum": ["new", "used", "preowned"]
        },
        "modelCondition": {
          "type": "string",
          "enum": ["mint", "excellent", "good", "fair", "poor"]
        },
        "boxCondition": {
          "type": "string",
          "enum": ["mint", "good", "damaged", "missing"]
        },
        "notes": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "purchase": {
          "$ref": "#/$defs/Purchase"
        }
      },
      "additionalProperties": false
    },
    "Purchase": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["purchased", "sold", "preordered"]
        },
        "purchaseDate": {
          "type": "string",
          "format": "date"
        },
        "price": {
          "$ref": "#/$defs/Money"
        },
        "sellerId": {
          "type": "string",
          "description": "References sellers[].id"
        },
        "saleDate": {
          "type": "string",
          "format": "date"
        },
        "salePrice": {
          "$ref": "#/$defs/Money"
        },
        "depositAmount": {
          "$ref": "#/$defs/Money"
        },
        "expectedDelivery": {
          "type": "string",
          "format": "date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "purchased" } }
          },
          "then": {
            "required": ["purchaseDate"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "sold" } }
          },
          "then": {
            "required": ["purchaseDate", "saleDate"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "preordered" } }
          },
          "then": {
            "required": ["sellerId"]
          }
        }
      ],
      "additionalProperties": false
    },
    "Money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0,
          "description": "Amount in smallest currency unit (e.g., cents)"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency code"
        }
      },
      "additionalProperties": false
    },
    "Seller": {
      "type": "object",
      "required": ["id", "name", "sellerType"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sellerType": {
          "type": "string",
          "enum": ["shop", "private", "marketplace", "distributor"]
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string"
        },
        "websiteUrl": {
          "type": "string",
          "format": "uri"
        },
        "address": {
          "$ref": "#/$defs/Address"
        }
      },
      "additionalProperties": false
    },
    "Address": {
      "type": "object",
      "properties": {
        "street": { "type": "string" },
        "city": { "type": "string" },
        "region": { "type": "string" },
        "postalCode": { "type": "string" },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      },
      "additionalProperties": false
    },
    "MaintenanceCard": {
      "type": "object",
      "required": ["id", "collectionItemId"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "collectionItemId": {
          "type": "string",
          "minLength": 1,
          "description": "References collectionItems[].id"
        },
        "lastMaintenanceDate": {
          "type": "string",
          "format": "date"
        },
        "nextMaintenanceDate": {
          "type": "string",
          "format": "date"
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/MaintenanceEvent" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "MaintenanceEvent": {
      "type": "object",
      "required": ["id", "date", "type"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "type": {
          "type": "string",
          "enum": ["cleaning", "lubrication", "repair", "modification", "inspection"]
        },
        "description": {
          "type": "string"
        },
        "cost": {
          "$ref": "#/$defs/Money"
        }
      },
      "additionalProperties": false
    },
    "TrackProduct": {
      "type": "object",
      "required": [
        "trackId",
        "manufacturerId",
        "productCode",
        "description",
        "trackType",
        "trackCode",
        "withRoadbed"
      ],
      "properties": {
        "trackId": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical TRN identifier, e.g. 'trn:track:marklin:24188'"
        },
        "manufacturerId": {
          "type": "string",
          "minLength": 1,
          "description": "References manufacturers[].id"
        },
        "productCode": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "trackType": {
          "type": "string",
          "enum": ["STRAIGHT", "CURVE", "TURNOUT", "FLEX_TRACK"]
        },
        "trackCode": {
          "type": "string",
          "enum": ["CODE_70", "CODE_75", "CODE_83", "CODE_100"]
        },
        "withRoadbed": {
          "type": "boolean"
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "description": "Length in mm (for straight track)"
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "description": "Radius in mm (for curved track)"
        }
      },
      "additionalProperties": false
    },
    "TrackInventory": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/TrackInventoryItem" },
          "default": []
        },
        "purchases": {
          "type": "array",
          "items": { "$ref": "#/$defs/TrackPurchase" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "TrackInventoryItem": {
      "type": "object",
      "required": ["trackId", "quantity"],
      "properties": {
        "trackId": {
          "type": "string",
          "minLength": 1,
          "description": "References trackProducts[].trackId"
        },
        "quantity": {
          "type": "integer",
          "minimum": 0
        },
        "required": {
          "type": "integer",
          "minimum": 0,
          "description": "Planned/required quantity"
        }
      },
      "additionalProperties": false
    },
    "TrackPurchase": {
      "type": "object",
      "required": ["id", "trackId", "quantity", "price", "purchaseDate"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "trackId": {
          "type": "string",
          "minLength": 1,
          "description": "References trackProducts[].trackId"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "price": {
          "$ref": "#/$defs/Money"
        },
        "sellerId": {
          "type": "string",
          "description": "References sellers[].id"
        },
        "purchaseDate": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "Prototype": {
      "type": "object",
      "required": [
        "id",
        "railwayCompanyId",
        "seriesCode",
        "carType",
        "category",
        "isMotorized",
        "isCustom"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "railwayCompanyId": {
          "type": "string",
          "minLength": 1,
          "description": "References railwayCompanies[].id"
        },
        "seriesCode": { "type": "string", "minLength": 1 },
        "carType": { "type": "string", "minLength": 1 },
        "serviceLevel": { "type": "string" },
        "category": { "type": "string", "minLength": 1 },
        "isMotorized": { "type": "boolean" },
        "isCustom": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "FormationCategory": {
      "type": "object",
      "required": ["id", "name", "isCustom"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "isCustom": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "TrainFormation": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "categoryId": { "type": "string" },
        "startYear": { "type": "integer" },
        "endYear": { "type": "integer" },
        "epoch": { "type": "string" },
        "notes": { "type": "string" },
        "elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/FormationElement" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "FormationElement": {
      "type": "object",
      "required": ["id", "prototypeId", "positionOrder", "tractionOverride"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "prototypeId": {
          "type": "string",
          "minLength": 1,
          "description": "References prototypes[].id"
        },
        "ownedRollingStockId": {
          "type": "string",
          "description": "Informational only; not restored on import"
        },
        "positionOrder": { "type": "integer", "minimum": 0 },
        "tractionOverride": { "type": "integer", "enum": [-1, 0, 1] }
      },
      "additionalProperties": false
    }
  }
}
